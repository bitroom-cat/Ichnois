# Copy to .env and fill in. Never commit .env.

# Development stub flags (safe local development without external credentials)
USE_STUB_GITHUB=true
USE_STUB_LLM=true
DRY_RUN=true

# GitHub Integration (Required when USE_STUB_GITHUB=false)
# GITHUB_TOKEN: Fine-grained PAT scoped to repository (Issues R/W, Contents R, Metadata R, Pull Requests R)
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
FALLBACK_ASSIGNEE=

# Sentry Webhook Integration (Required for live gateway signature verification)
SENTRY_CLIENT_SECRET=

# Database & Storage (Optional: For persistent cloud storage on Render/Serverless)
# If provided, runs and deduplication state will persist in Turso libSQL.
# If omitted, local SQLite (ichnoscope_runs.db) will be used automatically.
# Create free DB at https://turso.tech -> turso db create ichnoscope
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# General Behavior
PATH_PREFIX_STRIP=
SLACK_WEBHOOK_URL=
WINDOW_HOURS=24

# Severity Thresholds (Integers >= 0; P2 must be <= P1)
P1_USERS=50
P1_EVENTS=100
P2_USERS=10
P2_EVENTS=20

# LLM Fallback Chain (Comma-separated in priority order)
# Supported providers: gemini, groq, openrouter, pollinations, ollama
LLM_CHAIN=gemini,groq,openrouter,pollinations,ollama

# Provider: Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Provider: Groq
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Provider: OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Provider: Pollinations (Base URL must come from environment)
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=
POLLINATIONS_BASE_URL=

# Provider: Ollama (Local)
OLLAMA_MODEL=

# ==========================================
# Server B (v2) Dual-Gate & Gateway Bridge Config
# ==========================================
# Secret token used by Server A Edge Gateway to authenticate forwarded incidents
INTERNAL_GATEWAY_SECRET=ichnoscope-internal-gateway-token-v2

# Global Pipeline Automation Mode: full_manual | semi_autonomous | fully_autonomous
AUTOMATION_MODE=semi_autonomous

OLLAMA_BASE_URL=http://localhost:11434/v1
