# ===================================================================
# Server A: Standalone Edge Telemetry Gateway Configuration (.env.example)
# Copy to .env and configure for your deployment environment
# ===================================================================

# Server Bindings
EDGE_GATEWAY_HOST=0.0.0.0
EDGE_GATEWAY_PORT=8001

# Allowed Origins for CORS (use * or comma-separated domains)
EDGE_ALLOWED_ORIGINS=*

# Server B (Core Platform) Inter-Service Bridge
# Point to your Server B backend internal ingress endpoint
INTERNAL_CORE_URL=http://127.0.0.1:8000/internal/v1/incidents/ingress

# Shared secret matching Server B's INTERNAL_GATEWAY_SECRET
INTERNAL_GATEWAY_SECRET=ichnoscope-internal-gateway-token-v2

# Project Authentication Keys (Comma-separated list of valid client DSN keys)
EDGE_ALLOWED_PROJECT_KEYS=sentry_public_key,demo_key,prod_client_key
EDGE_ENFORCE_AUTH_WHITELIST=false

# Security Perimeter & Rate Limits
MAX_BODY_BYTES=51200
READ_TIMEOUT_SECONDS=2.5
MAX_JSON_DEPTH=10
IP_RATE_LIMIT_PER_MIN=60
PROJECT_RATE_LIMIT_PER_MIN=120
